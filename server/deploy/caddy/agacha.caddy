# agacha.app: roteador de pareamento (TV <-> iPad). Importado pelo Caddy da borda.
# - Sem log de acesso de propósito (não guardamos IPs nem códigos).
# - HTTPS por HTTP-01 (o token DNS-01 da borda é de outras zonas). A Cloudflare fica na frente e o ufw só deixa a Cloudflare entrar.
agacha.app {
	tls {
		protocols tls1.2 tls1.3
		resolvers 1.1.1.1 1.0.0.1
		issuer acme {
			dir {$ACME_CA}
			email {file./run/secrets/ACME_EMAIL}
			disable_tlsalpn_challenge
		}
	}
	encode zstd gzip
	header {
		defer
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; connect-src 'self'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
		-Server
		-Via
	}
	reverse_proxy 127.0.0.1:3501 {
		header_up X-Forwarded-For {client_ip}
		flush_interval -1
	}
}

www.agacha.app {
	tls {
		protocols tls1.2 tls1.3
		resolvers 1.1.1.1 1.0.0.1
		issuer acme {
			dir {$ACME_CA}
			email {file./run/secrets/ACME_EMAIL}
			disable_tlsalpn_challenge
		}
	}
	redir https://agacha.app{uri} permanent
}
